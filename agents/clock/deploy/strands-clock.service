[Unit]
Description=Strands A2A Clock Agent
Documentation=https://github.com/strands-agents/strands-a2a
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/strands_a2a

Environment="AWS_REGION=us-east-2"
Environment="API_HOST=0.0.0.0"
Environment="AGENT_PORT=9001"
Environment="PATH=/home/ec2-user/strands_a2a/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ExecStart=/home/ec2-user/strands_a2a/agents/clock/deploy/start_server.sh

Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=strands-clock

[Install]
WantedBy=multi-user.target
